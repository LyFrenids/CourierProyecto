// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator cliente{

  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
model cliente {
  idCliente Int @id @default(autoincrement())
  nombre String
  apellido String
  cedula String @unique
  telefono String
  correo String @unique
  activo Boolean @default(true)

  paquete paquete[]
  Direccion Direccion[]
}
model estadoPaquete{
  idEstado Int  @id @default(autoincrement())
  nombreEstado String @unique
  Descripcion String?
  activo Boolean @default(true)
  paquete  paquete[]
}
model paquete  {
  idPaquete Int @id @default(autoincrement())
    Tracking String @unique
    Descripcion String
    peso Decimal
    dimensiones String
    valorDeclarado Decimal
    idCliente Int 
    idEstado Int
    fechaRecepcion DateTime @default(now())

    cliente cliente @relation(fields: [idCliente], references: [idCliente])
    estado estadoPaquete @relation(fields: [idEstado], references: [idEstado])
    envio Envio[]
}

model Envio {
  idEnvio Int @id @default(autoincrement())
  idPaquete Int 
  idDireccionDestino Int
  fechaEnvio DateTime @default(now())
  fechaEntregaEstimada DateTime
  fechaEntregaReal DateTime?
  costoEnvio Decimal
  idRepartidor Int?

  paquete  paquete @relation(fields: [idPaquete], references: [idPaquete])
  direccionDestino Direccion @relation(fields: [idDireccionDestino], references: [idDireccion]) 
  Repartidor Empleado? @relation(fields: [idRepartidor], references: [idEmpleado])
  pagos pago[]
}

model Direccion {
  idDireccion Int @id @default(autoincrement())
  idCliente Int 
  calle String
  numero String 
  sector String
  ciudad String
  provincia String
  referencia String?
  tipoDireccion String

  cliente cliente @relation(fields: [idCliente], references: [idCliente])
  Envio  Envio[]
}

model pago{
  idPago Int  @id @default(autoincrement())
  idEnvio Int 
  monto Decimal
  metodoPago String 
  fechaPago DateTime @default(now())
  estadoPago  String
  referencia String?
  Envio  Envio  @relation(fields: [idEnvio], references: [idEnvio])
}

model Empleado{
  idEmpleado Int @id @default(autoincrement())
  nombre String 
  apellido String
  cedula String @unique
  telefono String
  correo String @unique 
  cargo String 
  activo Boolean @default(true)

  Envio   Envio[]
}



datasource db {
  provider = "postgresql"
}


